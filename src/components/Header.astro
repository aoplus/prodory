---
import BrandLogo from './BrandLogo.astro';
import { SITE, NAV_SERVICES, NAV_INDUSTRIES, NAV_RESOURCES } from '../data/site';
---
<header class="sticky top-0 z-50 h-16 border-b border-slate-200/80 bg-white/85 backdrop-blur-md">
  <div class="wrap flex h-full items-center justify-between gap-4">
    <a href="/" class="no-underline" aria-label="Prodory home"><BrandLogo /></a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        <li class="relative">
          <details class="group">
            <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-lg px-3 text-sm font-medium text-slate-600 hover:bg-slate-100/80 hover:text-slate-900">Services <span aria-hidden="true">▾</span></summary>
            <ul class="absolute left-0 top-full mt-2 min-w-[280px] rounded-xl bg-white p-2 shadow-xl shadow-slate-900/10 ring-1 ring-slate-200">
              {NAV_SERVICES.map((i) => <li><a href={i.href} class="flex items-center justify-between rounded-lg px-3 py-2.5 text-sm text-slate-700 no-underline hover:bg-blue-50/70 hover:text-blue-700">{i.label}</a></li>)}
            </ul>
          </details>
        </li>
        <li class="relative">
          <details class="group">
            <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-lg px-3 text-sm font-medium text-slate-600 hover:bg-slate-100/80 hover:text-slate-900">Industries <span aria-hidden="true">▾</span></summary>
            <ul class="absolute left-0 top-full mt-2 min-w-[280px] rounded-xl bg-white p-2 shadow-xl shadow-slate-900/10 ring-1 ring-slate-200">
              {NAV_INDUSTRIES.map((i) => <li><a href={i.href} class="flex items-center justify-between rounded-lg px-3 py-2.5 text-sm text-slate-700 no-underline hover:bg-blue-50/70 hover:text-blue-700">{i.label}</a></li>)}
            </ul>
          </details>
        </li>
        <li><a href="/case-studies/" class="flex min-h-11 items-center rounded-lg px-3 text-sm font-medium text-slate-600 no-underline hover:bg-slate-100/80 hover:text-slate-900">Case Studies</a></li>
        <li class="relative">
          <details class="group">
            <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-lg px-3 text-sm font-medium text-slate-600 hover:bg-slate-100/80 hover:text-slate-900">Resources <span aria-hidden="true">▾</span></summary>
            <ul class="absolute left-0 top-full mt-2 min-w-[280px] rounded-xl bg-white p-2 shadow-xl shadow-slate-900/10 ring-1 ring-slate-200">
              {NAV_RESOURCES.map((i) => <li><a href={i.href} class="flex items-center justify-between rounded-lg px-3 py-2.5 text-sm text-slate-700 no-underline hover:bg-blue-50/70 hover:text-blue-700">{i.label}</a></li>)}
            </ul>
          </details>
        </li>
        <li><a href="/about/" class="flex min-h-11 items-center rounded-lg px-3 text-sm font-medium text-slate-600 no-underline hover:bg-slate-100/80 hover:text-slate-900">About</a></li>
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={SITE.whatsapp} class="flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-slate-200 text-slate-700 no-underline hover:bg-slate-50" rel="noopener" aria-label="Chat on WhatsApp">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1l-.7.9c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1.1 2.6 11.4 11.4 0 0 0 4.4 3.9c2.2.9 2.6.7 3.1.7a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3Z"/></svg>
      </a>
      <a href="/architecture-review/" class="btn btn-primary hidden sm:inline-flex">Book Architecture Review</a>
    </div>

    <details class="lg:hidden">
      <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 px-3 text-sm text-slate-700">Menu</summary>
      <nav aria-label="Mobile" class="absolute inset-x-0 top-full z-50 max-h-[80vh] overflow-y-auto border-b border-slate-200 bg-white px-4 py-4 shadow-lg">
        <p class="mono-label mb-1 mt-2">Services</p>
        <ul>{NAV_SERVICES.map((i) => <li><a href={i.href} class="flex min-h-11 items-center text-slate-800 no-underline">{i.label}</a></li>)}</ul>
        <p class="mono-label mb-1 mt-4">Industries</p>
        <ul>{NAV_INDUSTRIES.map((i) => <li><a href={i.href} class="flex min-h-11 items-center text-slate-800 no-underline">{i.label}</a></li>)}</ul>
        <ul class="mt-4 border-t border-slate-200 pt-2">
          <li><a href="/case-studies/" class="flex min-h-11 items-center text-slate-800 no-underline">Case Studies</a></li>
          {NAV_RESOURCES.map((i) => <li><a href={i.href} class="flex min-h-11 items-center text-slate-800 no-underline">{i.label}</a></li>)}
          <li><a href="/about/" class="flex min-h-11 items-center text-slate-800 no-underline">About</a></li>
        </ul>
        <a href="/architecture-review/" class="btn btn-primary mt-4 w-full">Book Architecture Review</a>
      </nav>
    </details>
  </div>
</header>
