---
import BrandLogo from './BrandLogo.astro';
import { SITE, NAV_SERVICES, NAV_INDUSTRIES, NAV_RESOURCES } from '../data/site';
---
<header class="sticky top-0 z-50 border-b border-[#E5E7EB] bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-[1240px] items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="no-underline" aria-label="Prodory home"><BrandLogo /></a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        <li class="relative">
          <details class="group">
            <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1 rounded px-3 text-sm font-medium text-[#111827] hover:bg-[#F8F9FA]">Services <span aria-hidden="true">▾</span></summary>
            <ul class="absolute left-0 top-full mt-1 w-72 rounded border border-[#E5E7EB] bg-white p-2 shadow-sm">
              {NAV_SERVICES.map((i) => <li><a href={i.href} class="block rounded px-3 py-2 text-sm text-[#111827] no-underline hover:bg-[#F8F9FA]">{i.label}</a></li>)}
            </ul>
          </details>
        </li>
        <li class="relative">
          <details class="group">
            <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1 rounded px-3 text-sm font-medium text-[#111827] hover:bg-[#F8F9FA]">Industries <span aria-hidden="true">▾</span></summary>
            <ul class="absolute left-0 top-full mt-1 w-72 rounded border border-[#E5E7EB] bg-white p-2 shadow-sm">
              {NAV_INDUSTRIES.map((i) => <li><a href={i.href} class="block rounded px-3 py-2 text-sm text-[#111827] no-underline hover:bg-[#F8F9FA]">{i.label}</a></li>)}
            </ul>
          </details>
        </li>
        <li><a href="/case-studies/" class="flex min-h-11 items-center rounded px-3 text-sm font-medium text-[#111827] no-underline hover:bg-[#F8F9FA]">Case Studies</a></li>
        <li class="relative">
          <details class="group">
            <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1 rounded px-3 text-sm font-medium text-[#111827] hover:bg-[#F8F9FA]">Resources <span aria-hidden="true">▾</span></summary>
            <ul class="absolute left-0 top-full mt-1 w-72 rounded border border-[#E5E7EB] bg-white p-2 shadow-sm">
              {NAV_RESOURCES.map((i) => <li><a href={i.href} class="block rounded px-3 py-2 text-sm text-[#111827] no-underline hover:bg-[#F8F9FA]">{i.label}</a></li>)}
            </ul>
          </details>
        </li>
        <li><a href="/about/" class="flex min-h-11 items-center rounded px-3 text-sm font-medium text-[#111827] no-underline hover:bg-[#F8F9FA]">About</a></li>
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={SITE.whatsapp} class="flex min-h-11 min-w-11 items-center justify-center rounded border border-[#E5E7EB] text-sm text-[#111827] no-underline hover:bg-[#F8F9FA]" rel="noopener" aria-label="Chat on WhatsApp">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1l-.7.9c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1.1 2.6 11.4 11.4 0 0 0 4.4 3.9c2.2.9 2.6.7 3.1.7a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3Z"/></svg>
      </a>
      <a href="/architecture-review/" class="hidden min-h-11 items-center rounded bg-[#1D4ED8] px-4 text-sm font-semibold text-white no-underline hover:bg-[#1E40AF] sm:flex">Book Architecture Review</a>
    </div>

    <details class="lg:hidden">
      <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded border border-[#E5E7EB] px-3 text-sm text-[#111827]">Menu</summary>
      <nav aria-label="Mobile" class="absolute inset-x-0 top-full z-50 max-h-[80vh] overflow-y-auto border-b border-[#E5E7EB] bg-white px-4 py-4 shadow-sm">
        <p class="mb-1 mt-2 text-xs font-semibold uppercase tracking-wide text-[#4B5563]">Services</p>
        <ul>{NAV_SERVICES.map((i) => <li><a href={i.href} class="flex min-h-11 items-center text-[#111827] no-underline">{i.label}</a></li>)}</ul>
        <p class="mb-1 mt-4 text-xs font-semibold uppercase tracking-wide text-[#4B5563]">Industries</p>
        <ul>{NAV_INDUSTRIES.map((i) => <li><a href={i.href} class="flex min-h-11 items-center text-[#111827] no-underline">{i.label}</a></li>)}</ul>
        <ul class="mt-4 border-t border-[#E5E7EB] pt-2">
          <li><a href="/case-studies/" class="flex min-h-11 items-center text-[#111827] no-underline">Case Studies</a></li>
          {NAV_RESOURCES.map((i) => <li><a href={i.href} class="flex min-h-11 items-center text-[#111827] no-underline">{i.label}</a></li>)}
          <li><a href="/about/" class="flex min-h-11 items-center text-[#111827] no-underline">About</a></li>
        </ul>
        <a href="/architecture-review/" class="mt-4 flex min-h-11 items-center justify-center rounded bg-[#1D4ED8] font-semibold text-white no-underline">Book Architecture Review</a>
      </nav>
    </details>
  </div>
</header>
