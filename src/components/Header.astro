---
import { NAV, SITE } from '../data/site';
---
<header class="sticky top-0 z-20 border-b border-line bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="text-lg font-bold text-ink no-underline" aria-label="Prodory home">Prodory</a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-5">
        {NAV.map((item) => (
          <li><a href={item.href} class="text-sm text-muted no-underline hover:text-ink">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href={SITE.primaryCta.href} class="hidden rounded-lg bg-ink px-4 py-2 text-sm font-semibold text-paper no-underline hover:bg-brand-ink md:inline-block">
      {SITE.primaryCta.label}
    </a>

    <details class="md:hidden">
      <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-line px-3 text-sm text-ink">Menu</summary>
      <nav aria-label="Mobile" class="absolute inset-x-0 top-full border-b border-line bg-paper px-4 py-4 shadow-sm">
        <ul class="flex flex-col">
          {NAV.map((item) => (
            <li><a href={item.href} class="flex min-h-11 items-center text-base text-ink no-underline">{item.label}</a></li>
          ))}
        </ul>
        <a href={SITE.primaryCta.href} class="mt-3 block rounded-lg bg-ink px-4 py-3 text-center font-semibold text-paper no-underline">{SITE.primaryCta.label}</a>
      </nav>
    </details>
  </div>
</header>
