---
// Labelled engineering flow, drawn as inline SVG. Used for the service-page figures.
interface Props { title: string; caption: string; steps: string[] }
const { title, caption, steps } = Astro.props;
const W = 760;
const rowH = 58;
const H = steps.length * rowH + 24;
const id = `fig-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---
<figure class="my-8">
  <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>{title}</title>
    <desc id={`${id}-d`}>{`Flow: ${steps.join(' → ')}`}</desc>
    <rect x="0" y="0" width={W} height={H} fill="#0F172A" rx="4" />
    {steps.map((s, i) => {
      const y = 12 + i * rowH;
      return (
        <g>
          <rect x="24" y={y} width="712" height="42" rx="3" fill="none" stroke="#334155" stroke-width="1" />
          <text x="44" y={y + 26} fill="#E2E8F0" font-family="ui-monospace, JetBrains Mono, monospace" font-size="15">{s}</text>
          {i < steps.length - 1 && <path d={`M380 ${y + 42} L380 ${y + rowH}`} stroke="#60A5FA" stroke-width="1.5" marker-end="url(#arr)" />}
        </g>
      );
    })}
    <defs><marker id="arr" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="#60A5FA" /></marker></defs>
  </svg>
  <figcaption class="mt-2 text-sm text-[#4B5563]">{caption}</figcaption>
</figure>
