---
// Plain-text technology list. No partner logos and no partnership claims (see the Prodory master prompt).
import { WORKS_WITH } from '../data/site';
interface Props { heading?: string }
const { heading = 'Technologies we build with' } = Astro.props;
---
<section aria-labelledby="works-with" class="border-y border-[#E5E7EB] bg-[#F8F9FA]">
  <div class="mx-auto max-w-[1240px] px-4 py-8">
    <h2 id="works-with" class="text-xs font-semibold uppercase tracking-[0.12em] text-[#4B5563]">{heading}</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {WORKS_WITH.map((t) => <li class="rounded border border-[#E5E7EB] bg-white px-3 py-1.5 font-mono text-sm text-[#111827]">{t}</li>)}
    </ul>
  </div>
</section>
