---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, noindex = false, jsonLd = [] } = Astro.props;
const canonical = new URL(path, SITE.url).href;

// Organization schema on every page: the parent company facts from the registry, and the sameAs profiles.
const organization = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  name: 'Prodory',
  url: SITE.url,
  parentOrganization: { '@type': 'Organization', name: SITE.parent, identifier: [{ '@type': 'PropertyValue', name: 'CIN', value: SITE.cin }, { '@type': 'PropertyValue', name: 'GSTIN', value: SITE.gstin }, { '@type': 'PropertyValue', name: 'PAN', value: SITE.pan }] },
  taxID: SITE.gstin,
  address: { '@type': 'PostalAddress', streetAddress: `${SITE.head.line1}, ${SITE.head.line2}`, addressLocality: 'Dombivli', addressRegion: 'Maharashtra', postalCode: '421204', addressCountry: 'IN' },
  email: `mailto:${SITE.email}`,
  telephone: SITE.phone,
  foundingDate: String(SITE.founded),
};
const schemas = [organization, ...jsonLd];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index,follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prodory" />
    <meta property="og:image" content={new URL('/images/og-default.png', SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/images/og-default.png', SITE.url).href} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="min-h-dvh flex flex-col bg-white text-[#111827] antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded focus:bg-white focus:p-3 focus:shadow">Skip to content</a>
    <Header />
    <main id="main" class="flex-1 scroll-mt-24">
      <slot />
    </main>
    <Footer />
  </body>
</html>
