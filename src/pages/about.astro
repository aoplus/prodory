---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
const regs = [
  ['Legal entity', SITE.parent],
  ['CIN', SITE.cin],
  ['Startup recognition', SITE.dpiit],
  ['UDYAM', SITE.udyam],
  ['GSTIN', SITE.gstin],
  ['PAN', SITE.pan],
  ['Services code (SAC)', `${SITE.sac}, GST ${SITE.gstRate}`],
  ['Head office', `${SITE.head.line1}, ${SITE.head.line2}, ${SITE.head.line3}`],
];
const commitments = [
  'Everything we build is code in repositories your organisation owns.',
  'We hand over documentation and runbooks, and train the team that will run the platform.',
  'We state what we can and cannot verify. Where a result depends on your environment, we say so before you commit.',
];
---
<Base title="About Prodory | AO Plus Solutions" description="Prodory is the cloud-native infrastructure and platform engineering practice of AO Plus Solutions Pvt Ltd, Dombivli, Maharashtra." path="/about/">
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="wrap py-16 sm:py-20">
      <nav aria-label="Breadcrumb" class="text-sm muted"><a href="/" class="underline">Home</a> / About</nav>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950">About Prodory</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-slate-600">Prodory is the cloud-native infrastructure, Kubernetes and platform engineering practice of {SITE.parent}, founded in {SITE.founded} and based in Dombivli, Maharashtra, India.</p>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="text-2xl font-bold tracking-tight text-slate-950">How we work</h2>
    <ol class="mt-8 grid gap-6 md:grid-cols-3">
      {commitments.map((c, i) => (
        <li class="card p-7"><span class="mono-label text-blue-600">{String(i + 1).padStart(2, '0')}</span><p class="mt-4 text-sm leading-relaxed text-slate-700">{c}</p></li>
      ))}
    </ol>
  </section>

  <section class="band-soft">
    <div class="wrap section">
      <h2 class="text-2xl font-bold tracking-tight text-slate-950">Company registrations</h2>
      <dl class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {regs.map(([label, value]) => (
          <div class="card p-4">
            <dt class="mono-label mb-1">{label}</dt>
            <dd class="break-words text-sm font-semibold text-slate-900">{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="text-2xl font-bold tracking-tight text-slate-950">Leadership</h2>
    <div class="card mt-8 flex items-start gap-4 p-6">
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-600 font-semibold text-white" aria-hidden="true">BS</span>
      <p class="text-sm leading-relaxed text-slate-600">Bejoyata Singh, Founder and Director, AO Plus Solutions. Prodory team profiles are being prepared and will be published once each person has approved their profile.</p>
    </div>
  </section>
</Base>
