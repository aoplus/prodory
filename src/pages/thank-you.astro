---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you | Prodory" description="Your enquiry has been received." path="/thank-you/" noindex>
  <section class="mx-auto max-w-2xl px-4 py-20 text-center">
    <h1 class="text-4xl font-bold tracking-tight">Thank you</h1>
    <p class="mt-4 text-lg text-muted">We have your enquiry and will reply within one working day.</p>
    <a href="/" class="mt-8 inline-block min-h-11 rounded-lg border border-line px-5 py-3 font-semibold text-ink no-underline">Back to home</a>
  </section>
</Base>
