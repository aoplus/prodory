---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { SITE } from '../data/site';
const error = Astro.url.searchParams.get('error') === '1';
const tile = 'flex items-start justify-between gap-4 rounded-xl border border-slate-800 bg-slate-900/80 p-3.5 no-underline transition-colors hover:border-blue-500/50';
---
<Base title="Contact Prodory | Cloud & Kubernetes Enquiries" description="Contact Prodory for Kubernetes, VMware exit, sovereign cloud, infrastructure automation and cost optimisation enquiries. We reply within one working day." path="/contact/">
  <section class="wrap section">
    <div class="grid overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-lg shadow-slate-900/5 lg:grid-cols-12">
      <div class="flex flex-col justify-between bg-[#0B1120] p-8 text-white lg:col-span-5 lg:p-10">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Contact</h1>
          <p class="mt-4 text-slate-300">Send us the details of what you need to solve. We reply within one working day and suggest the next step.</p>
        </div>
        <ul class="mt-8 grid gap-3 text-sm">
          <li><a class={tile} href={`tel:${SITE.phoneTel}`}>Phone <span class="font-mono text-slate-300">{SITE.phone}</span></a></li>
          <li><a class={tile} href={SITE.whatsapp} rel="noopener">WhatsApp <span class="font-mono text-slate-300">{SITE.phone}</span></a></li>
          <li><a class={tile} href={SITE.calendly} rel="noopener">Book a call <span class="font-mono text-slate-300">calendly.com/aoplusin</span></a></li>
          <li class="flex items-start justify-between gap-4 rounded-xl border border-slate-800 bg-slate-900/80 p-3.5">Address <span class="max-w-[16rem] text-right text-slate-300">{SITE.head.line1}, {SITE.head.line2}, {SITE.head.line3}</span></li>
        </ul>
      </div>
      <div class="p-8 lg:col-span-7 lg:p-10">
        {error && <p role="alert" class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">Your enquiry could not be sent. Please try again, or email {SITE.email} or call {SITE.phone}.</p>}
        <EnquiryForm id="contact-enquiry" />
      </div>
    </div>
  </section>
</Base>
