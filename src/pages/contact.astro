---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { SITE } from '../data/site';
---
<Base title="Contact Prodory" description="Contact Prodory about Kubernetes, VMware exit, sovereign cloud, automation and cost engineering." path="/contact/">
  <section class="mx-auto max-w-3xl px-4 py-14">
    <nav aria-label="Breadcrumb" class="text-sm text-muted"><a href="/">Home</a> / Contact</nav>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">Contact us</h1>
    <p class="mt-4 text-muted">Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>, or send an enquiry below. We reply within one working day.</p>
    <p class="mt-2 text-sm text-muted">{SITE.parent}, {SITE.location}</p>
    <div class="mt-10">
      <EnquiryForm id="enquiry-contact" defaultCategory="general" />
    </div>
  </section>
</Base>
