---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Prodory" description="The page you asked for does not exist. Browse Prodory services, contact details and the home page to find what you need." path="/404" noindex>
  <section class="mx-auto max-w-[700px] px-4 py-24 text-center">
    <h1 class="text-4xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-4 text-[#4B5563]">The page may have moved. Try one of these:</p>
    <p class="mt-6 flex flex-wrap justify-center gap-4"><a class="underline" href="/services/">Services</a><a class="underline" href="/contact/">Contact</a><a class="underline" href="/">Home</a></p>
  </section>
</Base>
