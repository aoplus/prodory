---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
---
<Base title="Architecture Review | Prodory" description="A 30-minute architecture review of your Kubernetes, VMware or cloud platform, with a written next-step recommendation." path="/architecture-review/">
  <section class="mx-auto max-w-[1240px] px-4 py-16">
    <h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight">A 30-minute architecture review</h1>
    <p class="mt-4 max-w-2xl text-lg text-[#4B5563]">Bring your current platform. We review it against a readiness checklist and send a written note with the top risks and the sensible next step, whether or not you engage us.</p>
    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_1.2fr]">
      <div>
        <h2 class="text-xl font-semibold">What you receive</h2>
        <ul class="mt-4 grid list-disc gap-3 pl-5 text-[#4B5563]">
          <li>A readiness score across networking, security, delivery and operations.</li>
          <li>The top three risks in your current setup.</li>
          <li>A recommended next step, with an estimate of effort.</li>
        </ul>
        <p class="mt-6 text-sm text-[#4B5563]">The review is a conversation, not a sales call. We will not send you a proposal unless you ask for one.</p>
      </div>
      <div><EnquiryForm id="review-enquiry" defaultCategory="general" submit="Request architecture review" /></div>
    </div>
  </section>
</Base>
