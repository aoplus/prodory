---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
---
<Base title="Terms of use | Prodory" description="Terms for using the Prodory website." path="/legal/terms/">
  <article class="mx-auto max-w-3xl px-4 py-14">
    <nav aria-label="Breadcrumb" class="text-sm text-muted"><a href="/">Home</a> / Terms</nav>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">Terms of use</h1>
    <p class="mt-3 rounded-lg bg-card p-3 text-sm text-muted"><strong>Draft.</strong> Pending legal review. Engagement terms are agreed in writing for each project.</p>
    <p class="mt-6 text-muted">This website is provided for information. Content describes our services in general terms and is not an offer. Each engagement is governed by a written agreement with {SITE.parent}. Questions: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
  </article>
</Base>
