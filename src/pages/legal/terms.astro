---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
---
<Base title="Terms of Use | Prodory" description="Terms that apply to use of the Prodory website and enquiry process." path="/legal/terms/" noindex>
  <section class="mx-auto max-w-[900px] px-4 py-16">
    <p class="rounded border border-[#FCD34D] bg-[#FFFBEB] p-4 text-sm text-[#92400E]"><strong>Draft for counsel review.</strong> Not in force until reviewed and approved.</p>
    <h1 class="mt-8 text-4xl font-bold tracking-tight">Terms of use</h1>
    <ul class="mt-8 grid list-disc gap-3 pl-5 text-[#4B5563]">
      <li>The information on this website is general and does not constitute legal, financial or compliance advice.</li>
      <li>Service terms, pricing and acceptance criteria are set out in a separate written agreement or estimate.</li>
      <li>Content is owned by {SITE.parent} unless stated otherwise. You may quote short extracts with attribution.</li>
      <li>We aim to keep the site accurate. We may change content without notice.</li>
      <li>Governing law and jurisdiction: [to be set by counsel].</li>
    </ul>
  </section>
</Base>
