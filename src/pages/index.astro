---
import Base from '../layouts/Base.astro';
import WorksWith from '../components/WorksWith.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const industries = (await getCollection('industries')).sort((a, b) => a.data.order - b.data.order);

const faqs = [
  { q: 'What does Prodory build?', a: 'Production Kubernetes platforms, VMware exits to OpenShift or KubeVirt, sovereign and hybrid private cloud, infrastructure automation, and cloud cost work, all delivered as code in repositories you own.' },
  { q: 'Who owns the code and infrastructure definitions?', a: 'Your organisation. Repositories are created in your own Git organisation and handed over with documentation.' },
  { q: 'Where is Prodory based?', a: `${SITE.head.line2}, ${SITE.head.line3}. Prodory is a practice of ${SITE.parent}.` },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base
  title="Cloud-Native Infrastructure, Kubernetes & Platform Engineering Partner | Prodory"
  description="Prodory designs and operates production Kubernetes platforms, VMware exits to OpenShift and KubeVirt, sovereign private cloud and infrastructure automation, delivered as code you own."
  path="/"
  jsonLd={jsonLd}
>
  <section class="border-b border-[#E5E7EB]">
    <div class="mx-auto grid max-w-[1240px] gap-10 px-4 py-16 lg:grid-cols-[1.2fr_1fr] lg:py-24">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#1D4ED8]">Cloud-native infrastructure · Kubernetes · Platform engineering</p>
        <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">Production platforms your team can run, in code you own.</h1>
        <p class="mt-5 max-w-2xl text-lg text-[#4B5563]">Prodory designs, builds and hands over Kubernetes platforms, VMware exits, sovereign private cloud and infrastructure automation. Every component is code in your repositories, with a handover your team can run without us.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/architecture-review/" class="inline-flex min-h-11 items-center rounded bg-[#1D4ED8] px-5 font-semibold text-white no-underline hover:bg-[#1E40AF]">Book a 30-min architecture review</a>
          <a href="/services/" class="inline-flex min-h-11 items-center rounded border border-[#D1D5DB] px-5 font-semibold text-[#111827] no-underline hover:bg-[#F8F9FA]">Explore services</a>
        </div>
      </div>
      <aside class="grid content-start gap-3 rounded border border-[#E5E7EB] bg-[#F8F9FA] p-6 text-sm">
        <p class="font-semibold">Where we start</p>
        <ul class="grid list-none gap-3 p-0">
          <li>1. Architecture review of your current platform, scored against a readiness checklist.</li>
          <li>2. A written decision: stay, re-platform or exit, with the cost reasons.</li>
          <li>3. Waves of change, each with a tested rollback path and a handover.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="mx-auto max-w-[1240px] px-4 py-16" aria-labelledby="services-h">
    <h2 id="services-h" class="text-3xl font-bold tracking-tight">Five ways we help</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <a href={`/services/${s.id}/`} class="block rounded border border-[#E5E7EB] p-6 no-underline hover:border-[#1D4ED8]">
          <h3 class="text-lg font-semibold text-[#111827]">{s.data.title}</h3>
          <p class="mt-2 text-sm text-[#4B5563]">{s.data.lead}</p>
        </a>
      ))}
    </div>
  </section>

  <WorksWith />

  <section class="mx-auto max-w-[1240px] px-4 py-16" aria-labelledby="ind-h">
    <h2 id="ind-h" class="text-3xl font-bold tracking-tight">Who we work with</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {industries.map((i) => (
        <a href={`/industries/${i.id}/`} class="block rounded border border-[#E5E7EB] p-6 no-underline hover:border-[#1D4ED8]">
          <h3 class="text-lg font-semibold text-[#111827]">{i.data.title}</h3>
          <p class="mt-2 text-sm text-[#4B5563]">{i.data.lead}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-t border-[#E5E7EB] bg-[#F8F9FA]">
    <div class="mx-auto max-w-[1240px] px-4 py-16">
      <h2 class="text-3xl font-bold tracking-tight">Frequently asked</h2>
      <dl class="mt-8 grid gap-6 md:grid-cols-3">
        {faqs.map((f) => (
          <div>
            <dt class="font-semibold">{f.q}</dt>
            <dd class="mt-2 text-sm text-[#4B5563]">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-[760px] px-4 py-16" aria-labelledby="enq-h">
    <h2 id="enq-h" class="text-3xl font-bold tracking-tight">Start with an enquiry</h2>
    <p class="mt-3 text-[#4B5563]">Tell us what you need to solve. We reply within one working day.</p>
    <div class="mt-8"><EnquiryForm id="home-enquiry" /></div>
  </section>
</Base>
